DirectoryIndex index.html

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # The brochure has no API, authentication or form endpoints.
    RewriteRule ^(?:api|belepes|regisztracio|megerosites|demo|ajanlat)(?:/|$) - [R=404,L]
    RewriteRule (^|/)\. - [F,L]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]
    RewriteRule ^(?:portfolio(?:/[^/]+)?/?)?$ index.html [L]
    RewriteRule ^ - [R=404,L]
</IfModule>
